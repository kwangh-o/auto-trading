# 종목별 매매 설정
#
# 전략: 평단가 -10%에 추가 매수, +10%에 전량 매도를 반복하는 분할 매수 사이클.
#   - 매수가: 시가 × 0.95 와 평단가 × 0.9(잔고 보유 시) 중 낮은 값
#   - 매도가: 시가 와 평단가 × 1.1 중 높은 값
#   - 추가 매수 차수마다 투입 금액을 키워 물타기 시 손실률이 절반씩 줄도록 구성한다.
#   - 분할 매수 횟수를 늘리면 수익률을 낮추는 대신 리스크를 줄일 수 있다.
#   - 반대로 분할 매수 횟수를 줄이면 리스크를 높이는 대신 수익률을 높일 수 있다.
#
# buying_amount_list: 매수 차수별 price_per_order 배수. 리스트 길이 = 최대 매수 횟수.
#   예) [1, 1, 2, 4] → 최대 4회 분할, 총 투입금 8 × price_per_order
# market: 주문/잔고/체결확인/취소 API 거래소 코드
# price_market: 시세 조회 API(get_today_price_detail) 전용 거래소 코드

symbols:
  - code: "AAPL"
    market: "NASD"
    price_market: "NAS"
    price_per_order: 100000.0
    buying_amount_list: [1, 1, 2, 4]
